# Copy to `.env.local`. That file is gitignored (`.env*` / `!.env.example`) and
# is the single home for every credential this repo uses.
#
# The two blocks below are NOT equivalent. Read the headers before adding a key.

# ── PUBLIC ────────────────────────────────────────────────────────────────────
# Inlined into the client bundle by Next and shipped to every visitor.
# Never put a secret here. Anything NEXT_PUBLIC_* is world-readable.

# Canonical base of the deployed site. A user site always serves from the domain
# root, so there is no sub-path here.
NEXT_PUBLIC_SITE_URL=https://your-name.github.io

# Sub-path the site is served under. EMPTY for a user site
# (`your-name.github.io`); `/home-page` for a project site. Per-app values are
# derived by the build, never written here.
NEXT_PUBLIC_BASE_PATH=

# ── SECRET ────────────────────────────────────────────────────────────────────
# Read only by the dev-only admin routes and by scripts/ on your machine. These
# are excluded from the production build, and `scripts/check-export.mjs` fails
# the build if any value or name ever appears in `out/`.
#
# Every one of these is optional: unset, the matching tool falls back to its own
# credential store. `npm run creds` shows which source is in play.
#
# Prefer scoped, revocable tokens. A leak should be a rotation, not an incident.

# itch.io API key — https://itch.io/user/settings/api-keys
# Handed to butler as BUTLER_API_KEY. Unset → butler's own `butler login` store.
ITCH_API_KEY=

# npm automation token — https://www.npmjs.com/settings/<user>/tokens
# Used via a temporary userconfig; ~/.npmrc is never read or written.
# Unset → ~/.npmrc.
NPM_TOKEN=

# GitHub PAT with `repo` scope, for the gh-pages push. Only needed if you would
# rather not rely on git's macOS keychain helper. Unset → git credential helper.
GITHUB_TOKEN=
